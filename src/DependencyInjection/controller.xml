<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <defaults public="true"/>

        <service id="Bvsk\PluginBoilerplate\Controller\Api\ExampleApiController">
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="Bvsk\PluginBoilerplate\Controller\SalesChannel\ExampleSalesChannelController">
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="Bvsk\PluginBoilerplate\Controller\RedirectController">
            <argument type="service" id="Bvsk\PluginBoilerplate\Component\RedirectHandler\RedirectHandler" />
        </service>
    </services>
</container>